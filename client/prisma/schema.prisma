datasource db {
  provider = "sqlite"
  url      = "file:../../server/prisma/dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // ADMIN, USER, GUIDE
  permissions String   // JSON or comma-separated permissions
  users       User[]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  avatar        String?
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  bookings      Booking[]
  comments      Comment[]
  wishlist      Wishlist[]
  reviews       Review[]
  notifications Notification[]
  blogs         Blog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Country {
  id           String        @id @default(uuid())
  name         String        @unique
  continent    String        // Asia, Europe, Africa, Australia, North America, South America
  cities       City[]
  destinations Destination[]
}

model City {
  id        String   @id @default(uuid())
  name      String
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
}

model Destination {
  id           String     @id @default(uuid())
  name         String
  description  String
  image        String
  latitude     Float
  longitude    Float
  carbonRating String     // e.g. "A+", "A", "B"
  popular      Boolean    @default(false)
  countryId    String
  country      Country    @relation(fields: [countryId], references: [id])
  packages     Package[]
  hotels       Hotel[]
  activities   Activity[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique // Family, Adventure, Luxury, Solo, Group, Honeymoon, Eco
  slug     String    @unique
  packages Package[]
}

model Package {
  id              String      @id @default(uuid())
  name            String
  description     String
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  destinationId   String
  destination     Destination @relation(fields: [destinationId], references: [id])
  durationDays    Int
  price           Float
  maxGuests       Int
  image           String
  difficulty      String      // Easy, Moderate, Challenging, Extreme
  carbonFootprint Float       // In Metric Tons CO2 offset
  rating          Float       @default(0.0)
  highlights      String      // Semi-colon separated strings
  itinerary       String      // Semi-colon separated strings
  inclusions      String      // Semi-colon separated strings
  exclusions      String      // Semi-colon separated strings
  capacity        Int
  dates           String      // Semi-colon separated ISO date strings
  bookings        Booking[]
  wishlist        Wishlist[]
  reviews         Review[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Hotel {
  id            String      @id @default(uuid())
  name          String
  description   String
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  image         String
  type          String      // e.g. Tree House, Mountain Cabin, Forest Villa, Beach Eco Resort
  rating        Float       @default(0.0)
  amenities     String      // Semi-colon separated strings
  pricePerNight Float
  latitude      Float
  longitude     Float
  rooms         Room[]
  bookings      Booking[]
}

model Room {
  id            String    @id @default(uuid())
  hotelId       String
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  type          String    // Suite, Deluxe, Forest View, Villa
  pricePerNight Float
  capacity      Int
  image         String
  amenities     String    // Semi-colon separated
  bookings      Booking[]
}

model Activity {
  id            String      @id @default(uuid())
  name          String
  description   String
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  category      String      // Safari, Glamping, Scuba, Hiking, Kayaking, etc.
  durationHours Float
  price         Float
  image         String
}

model Booking {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  packageId       String?
  package         Package? @relation(fields: [packageId], references: [id])
  hotelId         String?
  hotel           Hotel?   @relation(fields: [hotelId], references: [id])
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id])
  checkInDate     DateTime
  checkOutDate    DateTime
  guestsCount     Int
  totalPrice      Float
  status          String   // PENDING, CONFIRMED, CANCELLED, COMPLETED
  stripePaymentId String?
  qrCode          String?  // Code representation for ticket
  payments        Payment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id])
  amount        Float
  currency      String   @default("USD")
  status        String   // PENDING, SUCCESS, FAILED
  method        String   // STRIPE, CREDIT_CARD
  transactionId String   @unique
  createdAt     DateTime @default(now())
}

model Blog {
  id        String    @id @default(uuid())
  title     String
  content   String
  image     String
  category  String    // e.g. Travel Guides, Eco Tips, Destination Stories, Photography, News
  readTime  Int       // In minutes
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(uuid())
  userName   String
  userAvatar String
  rating     Int
  comment    String
  videoUrl   String?
  location   String
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Faq {
  id        String @id @default(uuid())
  question  String
  answer    String
  category  String // e.g. General, Booking, Sustainability, Payments
}

model Wishlist {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  @@unique([userId, packageId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  packageId String
  package   Package  @relation(fields: [packageId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@unique([userId, packageId])
}

model NewsletterSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}
